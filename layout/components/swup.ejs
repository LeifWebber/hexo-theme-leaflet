<%- renderJS([
    'libs/Swup.min.js',
    'libs/SwupSlideTheme.min.js',
    'libs/SwupScriptsPlugin.min.js',
    'libs/SwupProgressPlugin.min.js',
    'libs/SwupScrollPlugin.min.js',
    'libs/SwupPreloadPlugin.min.js']
) %>
<script>
    const swup = new Swup({
        plugins: [
            new SwupScriptsPlugin({
                optin: true,
            }),
            new SwupProgressPlugin(),
            new SwupScrollPlugin({
                offset: 80,
            }),
            new SwupSlideTheme({
                mainElement: ".main-content-body",
            }),
            new SwupPreloadPlugin(),
        ],
        containers: ["#swup"],
    });

    swup.hooks.on("visit:start", (visit) => {
        const pathname = new URL(visit.to.url, window.location.origin).pathname;
        if (pathname === "/archives" || pathname.startsWith("/archives/")) {
            // Archive HTML changes on every publish, including pages preloaded by Swup.
            visit.cache.read = false;
            visit.cache.write = false;
        }
    });
</script>
