<% for (const mode of ['light', 'dark']) { %>
    <% const candidates = theme.home_banner.image || {}; const url = [candidates[mode], candidates.light, candidates.dark].find(value => typeof value === 'string' && value.trim()); %>
    <% if (url) { %>
    <div class="w-full h-full <%= mode === 'dark' ? 'hidden dark:block' : 'dark:hidden' %>">
        <%- progressiveImage(url_for(url), { alt: '', kind: 'cover', loading: 'eager', className: 'w-full h-full object-cover' }) %>
    </div>
    <% } %>
<% } %>
